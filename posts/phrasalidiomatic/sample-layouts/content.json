   "right": {"label": "May I", "examples": ["*May I* come in?", "*May I* ask a question?"], "note": "Polite and formal"},
   "tip_title": "Remember:", "tip": ["Can I -> friends [star]", "May I -> formal [star]"]},
  {"type": "compare", "layout": "curve", "title": "Lose vs Loose", "intro": "They look alike but mean different things.",
   "left": {"label": "Lose", "examples": ["Don't *lose* your keys.", "We may *lose* the match."], "note": "Verb"},
   "right": {"label": "Loose", "examples": ["This shirt is *loose*.", "The screw is *loose*."], "note": "Not tight"},
   "tip": ["Lose -> miss / fail [check]", "Loose -> not tight [check]"]},
  {"type": "compare", "layout": "divider", "title": "Lie vs Lay", "intro": "Both are about putting something down.",
