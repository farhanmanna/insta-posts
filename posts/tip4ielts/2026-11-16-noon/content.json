 "pages": [
  {
   "type": "pens",
   "sections": [
    {
     "heading": "A",
     "bullets": [
      "Before consonant sounds.",
      "One of many, mentioned first."
     ],
     "example": "She bought *a* car."
    },
    {
     "heading": "AN",
     "bullets": [
      "Before vowel sounds.",
      "Think sound, not spelling."
     ],
     "example": "It took *an* hour."
    },
    {
     "heading": "THE",
     "bullets": [
      "Something specific or known.",
      "Unique things: the sun."
     ],
     "example": "*The* car was very expensive."
    }
   ]
  },
  {
   "type": "sections",
   "sections": [
    {
     "heading": "AMOUNT",
     "bullets": [
      "Use with uncountable nouns.",
      "e.g. money, water, time."
     ],
     "examples": [
      "A large *amount* of water."
     ]
    },
    {
     "heading": "NUMBER",
     "bullets": [
      "Use with countable nouns.",
      "e.g. people, cars, books."
     ],
     "examples": [
      "A large *number* of people."
     ]
    }
   ]
  },
