 "pages": [
  {
   "type": "pens",
   "sections": [
    {
     "heading": "WHEREAS",
     "bullets": [
      "Joins two contrasting facts.",
      "Used inside one sentence."
     ],
     "example": "Cities are busy, *whereas* villages are calm."
    },
    {
     "heading": "IN CONTRAST",
     "bullets": [
      "Starts a new sentence.",
      "Compares two different things."
     ],
     "example": "*In contrast*, villages are quiet."
    },
    {
     "heading": "NEVERTHELESS",
     "bullets": [
      "Means 'but still' or 'even so'.",
      "Formal; starts a sentence."
     ],
     "example": "*Nevertheless*, many people stay in cities."
    }
   ]
  },
  {
   "type": "sections",
   "sections": [
    {
     "heading": "FOR EXAMPLE",
     "bullets": [
      "Followed by a full sentence.",
      "Put a comma after it."
     ],
     "examples": [
      "*For example*, Japan has fast trains."
     ]
    },
    {
     "heading": "SUCH AS",
     "bullets": [
      "Followed by nouns only.",
      "No comma straight after it."
     ],
     "examples": [
      "Countries *such as* Japan have fast trains."
     ]
    }
   ]
  },
