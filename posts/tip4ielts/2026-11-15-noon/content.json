   "title": "BAND 8 VERBS",
   "items": [
    {
     "word": "Exacerbate",
     "meaning": "to make a problem worse",
     "example": "Traffic *exacerbates* air pollution."
    },
    {
     "word": "Alleviate",
     "meaning": "to make a problem less severe",
     "example": "Parks can *alleviate* stress."
    },
    {
     "word": "Foster",
     "meaning": "to encourage something to develop",
     "example": "Team sports *foster* cooperation."
    }
