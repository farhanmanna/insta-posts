     "heading": "ADDICTED",
     "bullets": [
      "*Addicted to* is informal and strong.",
      "*Dependent on* is the formal version."
     ],
     "examples": [
      "Many teens are *addicted to* their phones.",
      "Farmers are *dependent on* good rain."
     ]
    },
    {
     "heading": "CONNECT / LINK",
     "bullets": [
      "*Connect* means join devices or people.",
      "*Link* means a clear connection."
     ],
     "examples": [
      "Please *connect* your laptop to Wi-Fi.",
      "Smoking is *linked to* lung disease."
     ]
    }
   ]
