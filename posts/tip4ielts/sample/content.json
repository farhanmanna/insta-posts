{"handle": "tip4ielts", "theme": "IELTS vocabulary and grammar essentials",
 "pages": [
  {"type": "sections", "sections": [
    {"heading": "AFFECT", "bullets": ["*Affect* is a verb.", "It means to change or influence something."],
     "examples": ["Pollution *affects* our health.", "Stress can *affect* your sleep."]},
    {"heading": "EFFECT", "bullets": ["*Effect* is a noun.", "It means the result of a change."],
     "examples": ["Pollution has a bad *effect* on health.", "The new law had little *effect*."]}]},
  {"type": "pens", "sections": [
    {"heading": "HOWEVER", "bullets": ["Starts a new sentence.", "Followed by a comma."], "example": "Cars are useful. *However*, they pollute the air."},
    {"heading": "ALTHOUGH", "bullets": ["Joins two ideas in one sentence.", "Followed by subject + verb."], "example": "*Although* cars are useful, they pollute the air."},
    {"heading": "DESPITE", "bullets": ["Followed by a noun or verb-ing.", "Never followed by subject + verb."], "example": "*Despite* being useful, cars pollute the air."}]},
