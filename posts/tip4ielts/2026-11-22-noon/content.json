  {
   "type": "pens",
   "sections": [
    {
     "heading": "AS A RESULT",
     "bullets": [
      "Shows a result.",
      "Use after a full stop."
     ],
     "example": "Prices rose. *As a result*, sales fell."
    },
    {
     "heading": "THEREFORE",
     "bullets": [
      "More formal.",
      "Use a comma after it."
     ],
     "example": "Costs are high; *therefore*, fewer people buy."
    },
    {
     "heading": "CONSEQUENTLY",
     "bullets": [
      "Formal result linker.",
      "Follow with a comma."
     ],
     "example": "Pollution grew. *Consequently*, health worsened."
    }
   ]
  },
