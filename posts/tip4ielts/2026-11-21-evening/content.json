    {
     "heading": "LEAD",
     "bullets": [
      "The present tense of the verb.",
      "Rhymes with 'need'."
     ],
     "examples": [
      "Poverty can *lead* to crime."
     ]
    },
    {
     "heading": "LED",
     "bullets": [
      "The past tense of 'lead'.",
      "Never write 'lead' for the past."
     ],
     "examples": [
      "The policy *led* to lower crime."
     ]
